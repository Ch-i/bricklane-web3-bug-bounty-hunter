# web3Sentinel uses authenticated CLIs (claude, codex) rather than API keys.
# This file documents the *non-LLM* secrets the system uses.

# Etherscan multichain key — used for /audit <address> mode.
# Free tier at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional: Sourcify is API-key-free; tried before Etherscan when present.

# Optional: override embedding model path (default: BAAI/bge-m3)
W3S_EMBED_MODEL=BAAI/bge-m3

# Optional: where the sqlite DB lives (default: repo-root/corpus.db)
W3S_DB_PATH=

# Optional: where the corpus markdown files live (default: repo-root/corpus)
W3S_CORPUS_DIR=
